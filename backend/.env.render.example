# ============================================================
# BACKEND — Render Deployment Environment Variables
# Service type: Web Service (Express)
# Root Directory: backend
# Build Command: npm install && npm run build
# Start Command: npm run start   (or your ts build/start script)
# ============================================================

# Render injects PORT automatically — do NOT hardcode it, but provide fallback
PORT=10000
NODE_ENV=production

# --- CORS: allow your deployed frontend origin (comma-separated list) ---
# Replace with your actual frontend URL on Render
ALLOWED_ORIGINS=https://YOUR-FRONTEND-SERVICE.onrender.com,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WRITE_MAX_REQUESTS=30

