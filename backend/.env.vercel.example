# ============================================================
# BACKEND — Vercel Deployment Environment Variables
# Project: pulsedx-api  (root directory: backend)
#
# Setup: vercel link  →  vercel env add <KEY> production
# Or: Vercel Dashboard → your project → Settings → Environment Variables
# ============================================================

# Vercel injects its own PORT for serverless functions — leave unset.
# NODE_ENV is set to "production" automatically by Vercel.

# --- CORS: allow your deployed frontend origin(s) (comma-separated) ---
# Replace with your real Vercel frontend URL after the frontend deploys
ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WRITE_MAX_REQUESTS=30

# --- Supabase (server-side secrets — NEVER expose to the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- MongoDB (teams feature) ---
MONGODB_URI=

# ============================================================
# NOTES:
# 1. Add an api/ entry point for serverless deployment OR deploy
#    as a Node service. See vercel.json in backend/ (if present).
# 2. Set ALLOWED_ORIGINS to your real frontend URL AFTER the
#    frontend deploy exists, then redeploy.
# 3. Never commit real secrets — this is an example file only.
# ============================================================
