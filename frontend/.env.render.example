# ============================================================
# FRONTEND — Render Deployment Environment Variables
# Service type: Web Service (Next.js)
# Root Directory: frontend
# Build Command: npm install && npm run build
# Start Command: npm run start
# ============================================================

# --- API Backend ---
# Point this at your Render backend URL (replace with your actual service URL)
NEXT_PUBLIC_API_URL=https://YOUR-BACKEND-SERVICE.onrender.com/api

# --- Supabase (public/anon values are safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://rmjpdsbpupoygknfcohh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJtanBkc2JwdXBveWdrbmZjb2hoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzMjI0MTYsImV4cCI6MjEwNDg5ODQxNn0.h2uZrWQi95_DteyeBJMgNSz0dSYvRQA35fY2jXWFE-o

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_3D_HERO=true
NEXT_PUBLIC_ENABLE_PARTICLES=true

# --- Node version (Render reads .nvmrc or this) ---
NODE_VERSION=20

# ============================================================
# NOTES:
# 1. NEXT_PUBLIC_* vars are BAKED INTO the build at compile time.
#    If you change them, you must trigger a NEW deploy for them to apply.
# 2. Set these in Render Dashboard -> your frontend service ->
#    Environment -> Add Environment Variable (or via render.yaml).
# 3. After your backend is deployed, replace YOUR-BACKEND-SERVICE
#    with its real onrender.com hostname, then redeploy the frontend.
# ============================================================
