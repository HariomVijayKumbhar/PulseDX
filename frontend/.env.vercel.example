# ============================================================
# FRONTEND — Vercel Deployment Environment Variables
# Project: pulsedx-frontend  (root directory: frontend)
#
# Setup: vercel link  →  vercel env add <KEY> production
# Or: Vercel Dashboard → your project → Settings → Environment Variables
# ============================================================

# --- API Backend (your deployed backend URL) ---
NEXT_PUBLIC_API_URL=https://YOUR-BACKEND.vercel.app/api

# --- Supabase (anon values are safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_3D_HERO=true
NEXT_PUBLIC_ENABLE_PARTICLES=true

# ============================================================
# NOTES:
# 1. NEXT_PUBLIC_* variables are BAKED INTO the build at compile time.
#    If you change them, you must REDEPLOY for them to apply.
# 2. Point NEXT_PUBLIC_API_URL at your deployed backend (Render or Vercel).
# 3. In the backend, set ALLOWED_ORIGINS to your frontend's vercel.app
#    URL so CORS allows the calls.
# 4. Never put SUPABASE_SERVICE_ROLE_KEY here — browser code must only
#    ever see the ANON key.
# ============================================================
