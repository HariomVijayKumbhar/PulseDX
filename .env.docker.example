# ============================================================
# PulseDX — Docker Environment Variables
#
# Copy this file to .env in the repository ROOT:
#   cp .env.docker.example .env
#
# Then fill in your Supabase credentials below.
# The .env file is gitignored — never commit it.
# ============================================================

# ── Supabase (required for users / projects / tasks) ──────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_ANON_KEY=<your-anon-key>

# ── Frontend public vars (baked in at Next.js build time) ─────
# If your browser talks directly to localhost:5000 (default), leave this as-is.
# For a remote backend, set the full URL, e.g. https://api.example.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ── Feature flags ─────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_3D_HERO=true
NEXT_PUBLIC_ENABLE_PARTICLES=true

# ── JWT (change the secret in production!) ────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WRITE_MAX_REQUESTS=30

# ── MongoDB ───────────────────────────────────────────────────
# When running via docker compose, the service name "mongo" is the hostname.
# This is already pre-set in docker-compose.yml, so you only need to
# override this if you're using MongoDB Atlas or an external instance.
#
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/pulsedx
