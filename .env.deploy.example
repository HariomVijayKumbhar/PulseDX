# ============================================================
# PulseDX — Deployment Environment Cheat Sheet
# Which env vars go WHERE for each platform.
# Never commit filled .env files — copy values into each
# platform's dashboard / CLI.
# ============================================================

# ────────────
# 1️⃣ BACKEND → Render  (Web Service, root: backend/)
#    Dashboard → pulsedx-api → Environment
# ────────────
NODE_ENV=production
ALLOWED_ORIGINS=https://pulsedx-frontend.onrender.com,https://YOUR-FRONTEND.vercel.app,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WRITE_MAX_REQUESTS=30
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-side only>
SUPABASE_ANON_KEY=<safe but keep server-side>
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/pulsedx
# NOTE: Render injects PORT itself. DATABASE_URL is optional (only if
# you connect to Postgres directly instead of via supabase-js).

# ────────────
# 2️⃣ FRONTEND → Vercel  (root: frontend/)
#    Dashboard → pulsedx-frontend → Settings → Environment Variables
# ────────────
NEXT_PUBLIC_API_URL=https://pulsedx-api.onrender.com/api
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key, browser-safe>
NEXT_PUBLIC_ENABLE_3D_HERO=true
NEXT_PUBLIC_ENABLE_PARTICLES=true

# ────────────
# 3️⃣ BACKEND → Vercel  (alternative to Render; root: backend/)
#    Dashboard → pulsedx-api → Settings → Environment Variables
#    (same keys as #1 but NO PORT — Vercel injects it)
# ────────────
ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app,http://localhost:3000
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-side only>
SUPABASE_ANON_KEY=<anon key>
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/pulsedx
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WRITE_MAX_REQUESTS=30

# ============================================================
# ORDER OF DEPLOYMENT:
#   1. Deploy backend first  → copy its URL
#   2. Set NEXT_PUBLIC_API_URL on frontend to that URL → deploy frontend
#   3. Copy frontend URL → set ALLOWED_ORIGINS on backend → redeploy backend
# ============================================================
